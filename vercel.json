{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=dev",
  "outputDirectory": "dist",
  "functions": {
    "api/briefing.ts": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/board.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
