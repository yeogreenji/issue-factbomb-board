{
  "name": "issue-factbomb-board",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "이슈온도계 — 한 줄 팩폭 이슈·트렌드 브리핑 보드. AI 팩폭 초안(Vercel /api/briefing)·공용 보드 발행·투표·팩폭 댓글(Vercel /api/board, Upstash/Supabase 선택)·공유 카드·에디터 발행 스튜디오",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json",
    "bundle:api": "esbuild api/board.ts --bundle --format=esm --platform=node --target=node20 --outfile=.tmp/board.mjs && esbuild api/briefing.ts --bundle --format=esm --platform=node --target=node20 --outfile=.tmp/briefing.mjs",
    "serve": "node scripts/serve.mjs",
    "verify": "python3 scripts/verify.py"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
